import { Theme } from "../styles/theme.slint";
import { SettingRow, Row } from "setting_row.slint";

export struct KindCard {
    id: string,
    title: string,
    desc: string,
    icon: string,
    c1: color,
    c2: color,
}

export struct InstItem {
    id: int,
    title: string,
    sub: string,
    expanded: bool,
    icon: string,
    c1: color,
    c2: color,
}

component Glyph inherits Rectangle {
    in property <string> d;
    in property <color> tint: white;
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.d;
        fill: transparent;
        stroke: root.tint;
        stroke-width: 1.8px;
        stroke-line-cap: round;
    }
}

component SmallButton inherits Rectangle {
    in property <string> label;
    in property <color> tint: Theme.text;
    callback clicked();
    height: 28px;
    width: lbl.preferred-width + 24px;
    border-radius: 8px;
    background: ta.has-hover ? #ffffff1a : #ffffff0d;
    lbl := Text {
        text: root.label;
        color: root.tint;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component WidgetsPanel inherits VerticalLayout {
    in property <[KindCard]> kinds;
    in property <[InstItem]> insts;
    in property <[Row]> inst-rows;
    in property <bool> widgets-on: true;
    callback add-widget(int);
    callback toggle(int);
    callback remove(int);
    callback duplicate(int);
    callback changed(int, string);

    property <length> cw: 156px;
    property <length> ch: 112px;
    property <length> gap: 10px;
    property <int> cols: Math.max(1, Math.floor(root.width / (root.cw + root.gap)));
    property <int> rows: Math.ceil(root.kinds.length / root.cols);

    spacing: 6px;

    // ---------- gallery ----------
    Text {
        text: "Add a widget";
        color: Theme.muted;
        font-size: 12px;
        font-weight: 700;
        height: 34px;
        vertical-alignment: bottom;
    }
    Rectangle {
        height: root.rows * (root.ch + root.gap);
        for k[i] in root.kinds : Rectangle {
            x: Math.mod(i, root.cols) * (root.cw + root.gap);
            y: Math.floor(i / root.cols) * (root.ch + root.gap);
            width: root.cw;
            height: root.ch;
            border-radius: 14px;
            background: @linear-gradient(145deg, k.c1, k.c2);
            clip: true;
            opacity: gta.has-hover ? 1.0 : 0.88;
            animate opacity { duration: 120ms; }

            Glyph {
                x: 14px;
                y: 14px;
                width: 30px;
                height: 30px;
                d: k.icon;
                tint: #ffffff;
            }
            Rectangle {
                x: parent.width - 38px;
                y: 12px;
                width: 26px;
                height: 26px;
                border-radius: 13px;
                background: #00000040;
                Text {
                    width: parent.width;
                    height: parent.height;
                    text: "+";
                    color: white;
                    font-size: 18px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            Text {
                x: 14px;
                y: root.ch - 52px;
                width: parent.width - 28px;
                text: k.title;
                color: white;
                font-size: 14px;
                font-weight: 700;
                overflow: elide;
            }
            Text {
                x: 14px;
                y: root.ch - 30px;
                width: parent.width - 28px;
                text: k.desc;
                color: #ffffffc8;
                font-size: 11px;
                overflow: elide;
            }
            gta := TouchArea {
                clicked => { root.add-widget(i); }
            }
        }
    }

    // ---------- your widgets ----------
    Text {
        text: root.insts.length == 0 ? "Your widgets" : "Your widgets (" + root.insts.length + ")";
        color: Theme.muted;
        font-size: 12px;
        font-weight: 700;
        height: 34px;
        vertical-alignment: bottom;
    }
    if root.insts.length == 0 : Rectangle {
        height: 62px;
        background: Theme.panel;
        border-radius: 10px;
        Text {
            x: 14px;
            width: parent.width - 28px;
            height: parent.height;
            text: "Nothing here yet. Click a card above and the widget appears on your desktop.";
            wrap: word-wrap;
            color: Theme.muted;
            font-size: 13px;
            vertical-alignment: center;
        }
    }
    for it[i] in root.insts : VerticalLayout {
        spacing: 2px;
        Rectangle {
            height: 56px;
            background: Theme.row;
            border-radius: 10px;

            header-ta := TouchArea {
                clicked => { root.toggle(it.id); }
            }
            Rectangle {
                x: 12px;
                y: 10px;
                width: 36px;
                height: 36px;
                border-radius: 10px;
                background: @linear-gradient(145deg, it.c1, it.c2);
                Glyph {
                    x: 7px;
                    y: 7px;
                    width: 22px;
                    height: 22px;
                    d: it.icon;
                    tint: #ffffff;
                }
            }
            Text {
                x: 60px;
                y: 10px;
                width: parent.width - 60px - 250px;
                text: it.title;
                color: Theme.text;
                font-size: 14px;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                x: 60px;
                y: 31px;
                width: parent.width - 60px - 250px;
                text: it.sub;
                color: Theme.muted;
                font-size: 12px;
                overflow: elide;
            }
            SmallButton {
                x: parent.width - 238px;
                y: 14px;
                label: "Duplicate";
                clicked => { root.duplicate(it.id); }
            }
            SmallButton {
                x: parent.width - 150px;
                y: 14px;
                label: "Delete";
                tint: #ff8a8a;
                clicked => { root.remove(it.id); }
            }
            Text {
                x: parent.width - 40px;
                width: 28px;
                height: parent.height;
                text: it.expanded ? "▾" : "▸";
                color: Theme.muted;
                font-size: 16px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        if it.expanded : VerticalLayout {
            padding-left: 8px;
            padding-top: 4px;
            padding-bottom: 8px;
            for r[j] in root.inst-rows : SettingRow {
                item: r;
                idx: j;
                changed(index, v) => { root.changed(index, v); }
            }
        }
    }
}
