import { Theme } from "../styles/themes.slint";
import { Icons } from "../styles/icons.slint";
import { Icon } from "controls.slint";

component InfoRow inherits Rectangle {
    in property <string> d;
    in property <string> text;
    height: 24px;

    Icon {
        x: 0px;
        y: 4px;
        width: 16px;
        height: 16px;
        d: root.d;
        tint: Theme.text-dim;
    }
    Text {
        x: 24px;
        y: 0px;
        width: parent.width - 24px;
        height: parent.height;
        text: root.text;
        color: Theme.text;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }
}

export component WeatherCard inherits Rectangle {
    in property <bool> ready: false;
    in property <string> city;
    in property <string> temp;
    in property <string> desc;
    in property <string> hilo;
    in property <string> humidity;
    in property <string> wind;
    // 0 sun, 1 partly cloudy, 2 cloud, 3 rain, 4 snow, 5 storm, 6 fog
    in property <int> kind: 2;

    property <string> icon-d: root.kind == 0 ? Icons.sun
        : (root.kind == 1 ? Icons.partly
        : (root.kind == 2 ? Icons.cloud
        : (root.kind == 3 ? Icons.rain
        : (root.kind == 4 ? Icons.snow
        : (root.kind == 5 ? Icons.storm : Icons.fog)))));

    if !root.ready : Text {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        text: "Loading weather...";
        color: Theme.text-dim;
        font-size: 14px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if root.ready : Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;

        Icon {
            x: 0px;
            y: 6px;
            width: 54px;
            height: 54px;
            d: root.icon-d;
            tint: Theme.accent;
        }
        Text {
            x: 66px;
            y: 4px;
            width: 110px;
            height: 56px;
            text: root.temp;
            color: Theme.text;
            font-size: 44px;
            font-weight: 700;
            vertical-alignment: center;
        }
        Text {
            x: 0px;
            y: 72px;
            width: 180px;
            height: 20px;
            text: root.city;
            color: Theme.text;
            font-size: 15px;
            font-weight: 700;
            overflow: elide;
            vertical-alignment: center;
        }
        Text {
            x: 0px;
            y: 92px;
            width: 180px;
            height: 18px;
            text: root.desc;
            color: Theme.text-dim;
            font-size: 12px;
            overflow: elide;
            vertical-alignment: center;
        }

        InfoRow { x: 196px; y: 10px; width: 120px; d: Icons.thermo; text: root.hilo; }
        InfoRow { x: 196px; y: 42px; width: 120px; d: Icons.droplet; text: root.humidity; }
        InfoRow { x: 196px; y: 74px; width: 120px; d: Icons.wind; text: root.wind; }
    }
}