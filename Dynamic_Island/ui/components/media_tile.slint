// ui/components/media_tile.slint
import { Theme } from "../styles/themes.slint";
import { Icons } from "../styles/icons.slint";
import { IconButton, Chip, Icon } from "controls.slint";

export struct SourceItem {
    key: string,
    label: string,
    active: bool,
}

export component MediaTile inherits Rectangle {
    in property <string> track-title;
    in property <string> track-artist;
    in property <string> source-name;
    in property <bool> playing;
    in property <bool> has-media;
    in property <float> progress;
    in property <[float]> viz;
    in property <image> album-art;
    in property <color> ambient-color: #222222;

    callback prev();
    callback toggle();
    callback next();
    callback seek(float);
    callback source-tapped();
    callback title-tapped();

    // Left Side: Album Art & Visualizer
    Rectangle {
        x: 0px; y: 0px;
        width: 90px; height: 90px;
        border-radius: 14px;
        background: Theme.chip;
        clip: true;

        if root.has-media : Image {
            width: parent.width; height: parent.height;
            source: root.album-art;
            image-fit: cover;
        }
        if !root.has-media : Icon {
            x: (parent.width - 32px) / 2;
            y: (parent.height - 32px) / 2;
            width: 32px; height: 32px;
            d: Icons.music;
            tint: Theme.text-dim;
        }

        // Mini visualizer (Pixel Box style) overlaying the bottom
        if root.playing : Rectangle {
            x: 0px; y: 64px;
            width: parent.width; height: 26px;
            background: @linear-gradient(0deg, #000000bb 0%, #00000000 100%);
            
            for b[i] in root.viz : Rectangle {
                x: 6px + i * 9px;
                y: parent.height - self.height;
                width: 6px;
                // Quantize height to 4px blocks to give it a pixelated look
                height: Math.max(4px, Math.round((b * 20px) / 4px) * 4px);
                border-radius: 1px;
                background: Theme.accent;
                animate height { duration: 80ms; }
            }
        }
    }

    // Right Side: Info & Controls
    Rectangle {
        x: 104px; y: 0px;
        width: parent.width - 104px;
        height: parent.height;
        background: transparent;

        // Title
        Text {
            x: 0px; y: 0px;
            width: parent.width - 80px;
            height: 26px;
            text: root.has-media ? root.track-title : "Nothing playing";
            color: (tt.has-hover && root.has-media) ? Theme.accent : Theme.text;
            font-size: 18px;
            font-weight: 700;
            overflow: elide;
            vertical-alignment: center;
            animate color { duration: 140ms; }
        }
        
        if root.has-media && tt.has-hover : Icon {
            x: parent.width - 20px;
            y: 5px;
            width: 15px; height: 15px;
            d: Icons.link;
            tint: Theme.accent;
        }
        tt := TouchArea {
            x: 0px; y: 0px;
            width: parent.width - 80px;
            height: 26px;
            enabled: root.has-media;
            mouse-cursor: pointer;
            clicked => { root.title-tapped(); }
        }

        // Artist
        Text {
            x: 0px; y: 26px;
            width: parent.width;
            height: 20px;
            text: root.has-media ? root.track-artist : "Play something to see it here";
            color: Theme.text-dim;
            font-size: 13px;
            overflow: elide;
            vertical-alignment: center;
        }

        // Source Pill
        Rectangle {
            x: parent.width - 86px; y: 24px;
            width: 86px; height: 22px;
            border-radius: 11px;
            background: st.has-hover ? Theme.chip-active : Theme.chip;
            animate background { duration: 140ms; }

            Text {
                x: 9px; y: 0px;
                width: parent.width - 26px; height: parent.height;
                text: root.source-name == "" ? "No player" : root.source-name;
                color: Theme.text;
                font-size: 11px;
                overflow: elide;
                vertical-alignment: center;
            }
            Path {
                x: parent.width - 16px; y: 9px;
                width: 8px; height: 5px;
                viewbox-width: 8; viewbox-height: 5;
                commands: "M 0 0 L 8 0 L 4 5 Z";
                fill: Theme.text-dim;
            }
            st := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.source-tapped(); }
            }
        }

        // Controls
        HorizontalLayout {
            x: 0px; y: 54px;
            width: parent.width;
            height: 36px;
            alignment: start;
            spacing: 12px;

            IconButton { kind: 0; clicked => { root.prev(); } }
            IconButton { kind: root.playing ? 2 : 1; clicked => { root.toggle(); } }
            IconButton { kind: 3; clicked => { root.next(); } }
        }

        // Progress Bar
        Rectangle {
            x: 0px; y: 96px;
            width: parent.width;
            height: 6px;
            border-radius: 3px;
            background: Theme.track;

            Rectangle {
                x: 0px; y: 0px;
                width: parent.width * root.progress;
                height: parent.height;
                border-radius: 3px;
                background: Theme.accent;
                animate width { duration: 250ms; easing: linear; }
            }

            TouchArea {
                x: 0px; y: -8px;
                width: parent.width;
                height: parent.height + 16px;
                mouse-cursor: pointer;
                clicked => { root.seek(self.mouse-x / self.width); }
            }
        }
    }
}

export component SourcePicker inherits Rectangle {
    in property <[SourceItem]> items;
    callback picked(string);
    callback back();

    Text {
        x: 0px; y: 0px;
        width: parent.width - 64px;
        height: 20px;
        text: "Control which player?";
        color: Theme.text-dim;
        font-size: 12px;
        vertical-alignment: center;
    }

    Chip {
        x: parent.width - 56px; y: 0px;
        width: 56px; height: 20px;
        text: "Back";
        clicked => { root.back(); }
    }

    VerticalLayout {
        x: 0px; y: 24px;
        width: parent.width;
        spacing: 3px;
        alignment: start;

        for item in root.items : Rectangle {
            height: 19px;
            border-radius: 8px;
            background: (item.active || row.has-hover) ? Theme.chip-active : Theme.chip;
            animate background { duration: 120ms; }

            Text {
                x: 10px; y: 0px;
                width: parent.width - 30px;
                height: parent.height;
                text: item.label;
                color: Theme.text;
                font-size: 12px;
                overflow: elide;
                vertical-alignment: center;
            }

            Rectangle {
                x: parent.width - 16px; y: 6px;
                width: 7px; height: 7px;
                border-radius: 3.5px;
                background: Theme.accent;
                opacity: item.active ? 1 : 0;
            }

            row := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.picked(item.key); }
            }
        }
    }
}