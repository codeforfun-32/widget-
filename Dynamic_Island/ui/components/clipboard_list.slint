import { Theme } from "../styles/themes.slint";
import { Icons } from "../styles/icons.slint";
import { Icon, Chip } from "controls.slint";
import { Scroller } from "scroller.slint";

export component ClipboardList inherits Rectangle {
    in property <[string]> clips;
    callback picked(int);
    callback removed(int);
    callback cleared();

    // header
    Text {
        x: 2px;
        y: 0px;
        width: parent.width - 80px;
        height: 26px;
        text: root.clips.length == 0 ? "Clipboard" : "Clipboard  (\{root.clips.length})";
        color: Theme.text-dim;
        font-size: 12px;
        vertical-alignment: center;
    }
    if root.clips.length > 0 : Chip {
        x: parent.width - 72px;
        y: 0px;
        width: 72px;
        text: "Clear all";
        clicked => { root.cleared(); }
    }

    if root.clips.length == 0 : Text {
        x: 0px;
        y: 28px;
        width: parent.width;
        height: parent.height - 28px;
        text: "Copy something and it shows up here";
        color: Theme.text-dim;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Scroller {
        x: 0px;
        y: 30px;
        width: parent.width;
        height: parent.height - 30px;
        content-height: root.clips.length * 42px;

        for clip[i] in root.clips : Rectangle {
            x: 0px;
            y: i * 42px;
            width: parent.width - 10px;
            height: 38px;
            border-radius: 12px;
            background: row.has-hover ? Theme.chip-active : Theme.chip;
            animate background { duration: 120ms; }
            clip: true;

            // icon bubble
            Rectangle {
                x: 8px;
                y: 7px;
                width: 24px;
                height: 24px;
                border-radius: 12px;
                background: #ffffff12;

                Icon {
                    x: 5px;
                    y: 5px;
                    width: 14px;
                    height: 14px;
                    d: Icons.clip;
                    tint: Theme.accent;
                }
            }

            Text {
                x: 40px;
                y: 0px;
                width: parent.width - 40px - 34px;
                height: parent.height;
                text: clip;
                color: Theme.text;
                font-size: 12px;
                wrap: word-wrap;
                overflow: elide;
                vertical-alignment: center;
            }

            row := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.picked(i); }
            }

            // delete button, shows on hover
            Rectangle {
                x: parent.width - 28px;
                y: 9px;
                width: 20px;
                height: 20px;
                border-radius: 10px;
                background: del.has-hover ? #ff5a5a66 : #ffffff1a;
                opacity: (row.has-hover || del.has-hover) ? 1 : 0;
                visible: self.opacity > 0.01;
                animate opacity { duration: 120ms; }

                Icon {
                    x: 5px;
                    y: 5px;
                    width: 10px;
                    height: 10px;
                    d: Icons.close;
                    tint: Theme.text;
                }
                del := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.removed(i); }
                }
            }
        }
    }
}