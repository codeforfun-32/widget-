import { Theme } from "../styles/themes.slint";
import { Icons } from "../styles/icons.slint";
import { IconTab } from "controls.slint";
import { Scroller } from "scroller.slint";

export struct NotifItem {
    time: string,
    app: string,
    title: string,
    body: string,
}

export component NotifList inherits Rectangle {
    in property <[NotifItem]> items;
    callback clear();

    // header
    Text {
        x: 2px;
        y: 0px;
        width: parent.width - 40px;
        height: 28px;
        text: root.items.length == 0 ? "Notifications" : "Notifications  (\{root.items.length})";
        color: Theme.text-dim;
        font-size: 12px;
        vertical-alignment: center;
    }
    if root.items.length > 0 : IconTab {
        x: parent.width - 32px;
        y: 0px;
        d: Icons.trash;
        clicked => { root.clear(); }
    }

    if root.items.length == 0 : Text {
        x: 0px;
        y: 28px;
        width: parent.width;
        height: parent.height - 28px;
        text: "No notifications";
        color: Theme.text-dim;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Scroller {
        x: 0px;
        y: 30px;
        width: parent.width;
        height: parent.height - 30px;
        content-height: root.items.length * 58px;

        for n[i] in root.items : Rectangle {
            x: 0px;
            y: i * 58px;
            width: parent.width - 10px;
            height: 54px;
            border-radius: 10px;
            background: Theme.chip;

            Text {
                x: 10px;
                y: 5px;
                width: parent.width - 110px;
                height: 14px;
                text: n.app;
                color: Theme.accent;
                font-size: 10px;
                overflow: elide;
                vertical-alignment: center;
            }
            Text {
                x: parent.width - 100px;
                y: 5px;
                width: 90px;
                height: 14px;
                text: n.time;
                color: Theme.text-dim;
                font-size: 10px;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            Text {
                x: 10px;
                y: 19px;
                width: parent.width - 20px;
                height: 17px;
                text: n.title;
                color: Theme.text;
                font-size: 12px;
                font-weight: 700;
                overflow: elide;
                vertical-alignment: center;
            }
            Text {
                x: 10px;
                y: 36px;
                width: parent.width - 20px;
                height: 14px;
                text: n.body;
                color: Theme.text-dim;
                font-size: 11px;
                overflow: elide;
                vertical-alignment: center;
            }
        }
    }
}
