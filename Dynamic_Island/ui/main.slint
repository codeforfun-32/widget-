// ui/main.slint
import { Theme } from "styles/themes.slint";
import { Tokens } from "styles/tokens.slint";
import { Icons } from "styles/icons.slint";
import { MascotView } from "components/mascot_view.slint";
import { MediaTile, SourcePicker, SourceItem } from "components/media_tile.slint";
import { ClipboardList } from "components/clipboard_list.slint";
import { QuickSettings, QuickState, QIcons } from "components/quick_settings.slint";
import { Scroller } from "components/scroller.slint";
import { CalendarView, CalCell, CalIcon } from "components/calendar.slint";
import { Ticker } from "components/ticker.slint";
import { Chip, IconTab, Page } from "components/controls.slint";
import { WeatherCard } from "components/weather_card.slint";
import { SpecPanel } from "components/spec_panel.slint";
import { NotifList, NotifItem } from "components/notif_list.slint";
import { SiteGrid, SiteItem } from "components/site_grid.slint";


export { SourceItem, NotifItem, SiteItem, QuickState, CalCell }
export component MainWindow inherits Window {
    no-frame: true;
    always-on-top: true;
    background: transparent;
    title: "Dynamic Island";
    preferred-width: 520px;
    preferred-height: 230px;

    in-out property <bool> expanded: false;
    in-out property <int> page: 0;
    in-out property <int> mood: 0;
    in-out property <float> look-x: 0;
    in-out property <float> look-y: 0;
    in-out property <bool> source-menu: false;
    in-out property <bool> playing: false;
    in-out property <string> ticker-text: "";
    in-out property <string> ticker-app: "";
    in-out property <string> ticker-body: "";
    in-out property <bool> ticker-active: false;
    in-out property <string> track-title: "";
    in-out property <string> track-artist: "";
    in-out property <string> source-name: "";
    in-out property <bool> spec-pill: false;
    in-out property <int> notif-unread: 0;
    in-out property <bool> hidden: false;

    in property <[SourceItem]> sources: [];
    in property <bool> has-media: false;
    in property <float> progress: 0;
    in property <[string]> clips: [];
    in property <[float]> viz: [];
    in property <bool> timer-running: false;
    in property <string> timer-text: "00:00";

    in property <[NotifItem]> notifs: [];
    in property <[SiteItem]> sites: [];
    in property <[CalCell]> cal-cells: [];
    in property <string> cal-title: "";
    in property <int> cal-today-day: 1;
    in property <string> cal-today-name: "";
    in property <string> clock-time: "";
    in property <string> clock-date: "";

    in property <bool> weather-ready: false;
    in property <string> weather-city: "";
    in property <string> weather-temp: "";
    in property <string> weather-desc: "";
    in property <string> weather-hilo: "";
    in property <string> weather-humidity: "";
    in property <string> weather-wind: "";
    in property <int> weather-kind: 2;

    in property <float> spec-cpu: 0;
    in property <float> spec-ram: 0;
    in property <float> spec-gpu: -1;
    in property <float> spec-batt: 0;
    in property <string> spec-ram-text: "";
    in property <string> spec-down: "0 B/s";
    in property <string> spec-up: "0 B/s";
    in property <string> spec-text: "";
    in property <bool> spec-batt-present: false;
    in property <bool> spec-charging: false;

    in property <image> media-art;
    in property <color> media-ambient-color: #18181b;

    out property <length> island-w: island.width;
    out property <length> island-h: island.height;
    out property <length> island-y: island.y;
    out property <bool> tucked: root.hidden && !root.ticker-active && !root.expanded;

    callback poked();
    callback media-prev();
    callback media-toggle();
    callback media-next();
    callback seek(float);
    callback source-picked(string);
    callback title-tapped();
    callback copy-clip(int);
    callback clip-remove(int);
    callback clip-clear();
    callback timer-start(int);
    callback timer-stop();
    callback site-add();
    callback site-open(int);
    callback site-remove(int);
    callback notifs-clear();
    callback open-settings();
    callback cal-step(int);
    callback cal-reset();
    callback quit-app();

    public function show-ticker(message: string) {
        root.ticker-app = "";
        root.ticker-body = "";
        root.ticker-text = message;
        root.ticker-active = true;
    }

    public function show-toast(app: string, title: string, body: string) {
        root.ticker-app = app == "" ? "Notification" : app;
        root.ticker-text = title;
        root.ticker-body = body;
        root.ticker-active = true;
    }

    property <float> tick: 0;
    property <bool> toast: root.ticker-active && !root.expanded && root.ticker-app != "";
    property <string> pill-text: root.ticker-active ? root.ticker-text
        : ((root.spec-pill && root.spec-text != "") ? root.spec-text
        : (root.timer-running ? root.timer-text
        : (root.playing ? root.track-title : "")));
    property <bool> pill-busy: root.pill-text != "";

    Timer {
        interval: 2000ms;
        running: root.ticker-active;
        triggered => { root.ticker-active = false; }
    }

    Timer {
        interval: 120ms;
        running: true;
        triggered => { root.tick = Math.mod(root.tick + 1, 28); }
    }

    island := Rectangle {
        width: root.tucked ? 118px
            : (root.expanded ? Tokens.card-width
            : (root.toast ? 340px
            : (root.pill-busy ? Tokens.pill-wide-width : Tokens.pill-width)));
        height: root.tucked ? 8px
            : (root.expanded ? Tokens.card-height
            : (root.toast ? 62px : Tokens.pill-height));
        x: (root.width - self.width) / 2;
        y: root.tucked ? -3px : Tokens.top-gap;
        border-radius: root.tucked ? 4px : (root.expanded ? 30px : 18px);
        background: Theme.surface;
        border-width: root.tucked ? 0px : 1px;
        border-color: Theme.border;
        clip: true;

        // Add ambient glow to the expanded island background
        if root.expanded && root.page == 0 && root.has-media : Rectangle {
            width: parent.width; height: parent.height;
            background: root.media-ambient-color;
            opacity: 0.15;
            drop-shadow-blur: 50px;
            drop-shadow-color: root.media-ambient-color;
        }

        animate width { duration: 460ms; easing: cubic-bezier(0.34, 1.3, 0.64, 1); }
        animate height { duration: 460ms; easing: cubic-bezier(0.34, 1.3, 0.64, 1); }
        animate y { duration: 360ms; easing: ease-out; }
        animate border-radius { duration: 460ms; easing: ease-out; }
        animate background { duration: 300ms; }

        Rectangle {
            x: 0px; y: 0px;
            width: parent.width; height: 46px;
            background: @linear-gradient(180deg, Theme.sheen-top 0%, #ffffff00 100%);
        }

        Ticker {
            x: 44px; y: 0px;
            width: parent.width - 58px;
            height: Tokens.pill-height;
            text: root.pill-text;
            shown: !root.expanded && !root.tucked && !root.toast;
        }

        if root.toast : Rectangle {
            x: 0px; y: 0px;
            width: parent.width; height: parent.height;

            Text {
                x: 46px; y: 9px;
                width: parent.width - 60px; height: 14px;
                text: root.ticker-app;
                color: Theme.accent;
                font-size: 10px; font-weight: 700;
                overflow: elide; vertical-alignment: center;
            }
            Text {
                x: 46px; y: 22px;
                width: parent.width - 60px; height: 18px;
                text: root.ticker-text;
                color: Theme.text;
                font-size: 13px; font-weight: 700;
                overflow: elide; vertical-alignment: center;
            }
            Text {
                x: 46px; y: 40px;
                width: parent.width - 60px; height: 15px;
                text: root.ticker-body;
                color: Theme.text-dim;
                font-size: 11px;
                overflow: elide; vertical-alignment: center;
            }
        }

        Rectangle {
            x: 0px; y: 0px;
            width: parent.width; height: parent.height;
            opacity: root.expanded ? 1 : 0;
            visible: island.height > 80px;
            animate opacity { duration: 220ms; }

            for ic[i] in [Icons.home, Icons.sun, Icons.chip, Icons.bell, Icons.globe, Icons.clip, QIcons.wifi, Icons.timer, CalIcon.d] : IconTab {
                x: Tokens.pad + i * 33px; y: 10px;
                d: ic;
                active: root.page == i;
                badge: i == 3 ? root.notif-unread : 0;
                clicked => { root.page = i; root.source-menu = false; }
            }

            IconTab {
                x: parent.width - Tokens.pad - 32px - 68px; y: 10px;
                d: Theme.oled ? Icons.moon : Icons.sun;
                clicked => { Theme.oled = !Theme.oled; }
            }
            IconTab {
                x: parent.width - Tokens.pad - 32px - 34px; y: 10px;
                d: Icons.sliders;
                clicked => { root.open-settings(); }
            }
            IconTab {
                x: parent.width - Tokens.pad - 32px; y: 10px;
                d: Icons.power;
                clicked => { root.quit-app(); }
            }

            Text {
                x: Tokens.pad; y: 134px;
                width: 76px; height: 24px;
                text: root.clock-time;
                color: Theme.text;
                font-size: 20px; font-weight: 700;
                horizontal-alignment: center; vertical-alignment: center;
            }
            Text {
                x: Tokens.pad - 4px; y: 158px;
                width: 84px; height: 16px;
                text: root.clock-date;
                color: Theme.text-dim;
                font-size: 11px;
                horizontal-alignment: center; vertical-alignment: center;
            }

            Page {
                x: 106px; width: 316px; height: 130px;
                active: root.page == 0 && !root.source-menu;

                MediaTile {
                    x: 0px; y: 0px;
                    width: parent.width; height: 130px;
                    track-title: root.track-title;
                    track-artist: root.track-artist;
                    source-name: root.source-name;
                    playing: root.playing;
                    has-media: root.has-media;
                    progress: root.progress;
                    viz: root.viz;
                    
                    album-art: root.media-art;
                    ambient-color: root.media-ambient-color;

                    prev => { root.media-prev(); }
                    toggle => { root.media-toggle(); }
                    next => { root.media-next(); }
                    seek(f) => { root.seek(f); }
                    source-tapped => { root.source-menu = true; }
                    title-tapped => { root.title-tapped(); }
                }
            }
            
            Page {
                x: 106px; width: 316px; height: 130px;
                active: root.page == 0 && root.source-menu;

                SourcePicker {
                    x: 0px; y: 0px;
                    width: parent.width; height: parent.height;
                    items: root.sources;
                    picked(key) => { root.source-picked(key); }
                    back => { root.source-menu = false; }
                }
            }

            Page {
                x: 106px; width: 316px; height: 130px;
                active: root.page == 1;
                Scroller {
                    x: 0px; y: 0px; width: parent.width; height: parent.height;
                    content-height: 130px;
                    WeatherCard {
                        x: 0px; y: 0px; width: parent.width; height: 130px;
                        ready: root.weather-ready; city: root.weather-city; temp: root.weather-temp;
                        desc: root.weather-desc; hilo: root.weather-hilo; humidity: root.weather-humidity;
                        wind: root.weather-wind; kind: root.weather-kind;
                    }
                }
            }

            Page {
                x: 106px; width: 316px; height: 130px;
                active: root.page == 2;
                Scroller {
                    x: 0px; y: 0px; width: parent.width; height: parent.height;
                    content-height: 134px;
                    SpecPanel {
                        x: 0px; y: 0px; width: parent.width; height: 134px;
                        cpu: root.spec-cpu; ram: root.spec-ram; gpu: root.spec-gpu; batt: root.spec-batt;
                        ram-text: root.spec-ram-text; down: root.spec-down; up: root.spec-up;
                        batt-present: root.spec-batt-present; charging: root.spec-charging;
                        pinned: root.spec-pill; pin-toggled => { root.spec-pill = !root.spec-pill; }
                    }
                }
            }

            Page {
                x: 106px; width: 316px; height: 130px;
                active: root.page == 3;
                NotifList {
                    x: 0px; y: 0px; width: parent.width; height: parent.height;
                    items: root.notifs; clear => { root.notifs-clear(); }
                }
            }

            Page {
                x: 106px; width: 316px; height: 130px;
                active: root.page == 4;
                Scroller {
                    x: 0px; y: 0px; width: parent.width; height: parent.height;
                    content-height: Math.max(130px, Math.ceil((root.sites.length + 1) / 5) * 64px);
                    SiteGrid {
                        x: 0px; y: 0px; width: parent.width;
                        height: Math.max(130px, Math.ceil((root.sites.length + 1) / 5) * 64px);
                        sites: root.sites;
                        opened(i) => { root.site-open(i); }
                        removed(i) => { root.site-remove(i); }
                        add-requested => { root.site-add(); }
                    }
                }
            }

            Page {
                x: 106px; width: 316px; height: 130px;
                active: root.page == 5;
                ClipboardList {
                    x: 0px; y: 0px; width: parent.width; height: parent.height;
                    clips: root.clips;
                    picked(i) => { root.copy-clip(i); }
                    removed(i) => { root.clip-remove(i); }
                    cleared => { root.clip-clear(); }
                }
            }

            Page {
                x: 106px; width: 316px; height: 130px;
                active: root.page == 6;
                QuickSettings {
                    x: 0px; y: 0px; width: parent.width; height: parent.height;
                }
            }

            Page {
                x: 106px; width: 316px; height: 130px;
                active: root.page == 7;
                Text {
                    x: 0px; y: 0px; width: parent.width; height: 56px;
                    text: root.timer-running ? root.timer-text : "00:00";
                    color: Theme.text; font-size: 44px; font-weight: 700;
                    horizontal-alignment: center; vertical-alignment: center;
                }
                Chip { x: 0px;   y: 70px; width: 70px; text: "5 min";  clicked => { root.timer-start(5); } }
                Chip { x: 82px;  y: 70px; width: 70px; text: "10 min"; clicked => { root.timer-start(10); } }
                Chip { x: 164px; y: 70px; width: 70px; text: "25 min"; clicked => { root.timer-start(25); } }
                Chip { x: 246px; y: 70px; width: 70px; text: "Stop";   clicked => { root.timer-stop(); } }
            }

            Page {
                x: 106px; width: 316px; height: 130px;
                active: root.page == 8;
                CalendarView {
                    x: 0px; y: 0px; width: parent.width; height: parent.height;
                    cells: root.cal-cells; title: root.cal-title;
                    today-day: root.cal-today-day; today-name: root.cal-today-name;
                    step(d) => { root.cal-step(d); }
                    go-today => { root.cal-reset(); }
                }
            }
        }

        MascotView {
            x: root.expanded ? Tokens.pad : 10px;
            y: root.expanded ? 52px : (root.toast ? 18px : 5px);
            width: root.expanded ? 76px : 26px;
            height: self.width;
            opacity: root.tucked ? 0 : 1;
            look-x: root.look-x; look-y: root.look-y; mood: root.mood;
            blinking: root.tick == 0;
            poked => { root.poked(); }

            animate x { duration: 460ms; easing: cubic-bezier(0.34, 1.3, 0.64, 1); }
            animate y { duration: 460ms; easing: cubic-bezier(0.34, 1.3, 0.64, 1); }
            animate width { duration: 460ms; easing: cubic-bezier(0.34, 1.3, 0.64, 1); }
            animate opacity { duration: 160ms; }
        }
    }
}