    out property <string> cloud: "M 7 18 A 4 4 0 0 1 6 10 A 6 6 0 0 1 17.5 9 A 4.5 4.5 0 0 1 18 18 Z";
    out property <string> rain: "M 7 14 A 4 4 0 0 1 6 6 A 6 6 0 0 1 17.5 5 A 4.5 4.5 0 0 1 18 14 Z M 8 17 L 7 21 M 12 17 L 11 21 M 16 17 L 15 21";
