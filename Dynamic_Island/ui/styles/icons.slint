    out property <string> sliders: "M 4 7 L 20 7 M 4 17 L 20 17 M 9 4 L 9 10 M 15 14 L 15 20";
    out property <string> power: "M 12 3 L 12 11 M 7 6.5 A 8 8 0 1 0 17 6.5";
    out property <string> moon: "M 20 14 A 8 8 0 1 1 10 4 A 6.5 6.5 0 0 0 20 14 Z";
    out property <string> close: "M 6 6 L 18 18 M 18 6 L 6 18";
