    out property <string> thermo: "M 10 14 L 10 5 A 2 2 0 0 1 14 5 L 14 14 A 4 4 0 1 1 10 14 Z";
    out property <string> link: "M 14 4 L 20 4 L 20 10 M 20 4 L 11 13 M 18 14 L 18 20 L 4 20 L 4 6 L 10 6";
    
    // NEW MUSIC ICON ADDED HERE
    out property <string> music: "M 9 18 A 3 3 0 1 1 9 12 A 3 3 0 0 1 9 18 Z M 12 15 L 12 4 L 20 6 L 20 9 L 12 7";

    // quick settings
    out property <string> wifi: "M 2 9 A 14 14 0 0 1 22 9 M 5 12.5 A 9.5 9.5 0 0 1 19 12.5 M 8.5 16 A 5 5 0 0 1 15.5 16 M 12 19.5 L 12 19.6";
    out property <string> bluetooth: "M 7 7 L 17 17 L 12 22 L 12 2 L 17 7 L 7 17";
