    out property <string> storm: "M 7 14 A 4 4 0 0 1 6 6 A 6 6 0 0 1 17.5 5 A 4.5 4.5 0 0 1 18 14 Z M 13 14 L 10 18 L 14 18 L 11 22";
    out property <string> fog: "M 4 9 L 20 9 M 6 13 L 18 13 M 4 17 L 20 17 M 8 21 L 16 21";
}