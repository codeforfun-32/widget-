    out property <string> clip: "M 6 5 L 18 5 L 18 21 L 6 21 Z M 9 3 L 15 3 L 15 7 L 9 7 Z";
    out property <string> mic: "M 9 6 A 3 3 0 0 1 15 6 L 15 12 A 3 3 0 0 1 9 12 Z M 5 11 A 7 7 0 0 0 19 11 M 12 18 L 12 22";
